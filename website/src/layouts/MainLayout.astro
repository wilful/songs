---
import { getAllSongs } from '../utils/songParser.js';

interface Props {
  title: string;
  activeArtistSlug?: string;
  activeSongSlug?: string;
}

const { title, activeArtistSlug = '', activeSongSlug = '' } = Astro.props;

const base = import.meta.env.BASE_URL; // '/songs/'

// Fetch all songs for the drawer / navigation
const songs = getAllSongs();

// Group songs by artist
const groupedSongs = songs.reduce((acc, song) => {
  if (!acc[song.artist]) {
    acc[song.artist] = {
      name: song.artist,
      slug: song.artistSlug,
      songs: []
    };
  }
  acc[song.artist].songs.push(song);
  return acc;
}, {} as Record<string, { name: string; slug: string; songs: typeof songs }>);

// Sort artists alphabetically, songs inside each artist too
const sortedArtists = Object.values(groupedSongs).sort((a, b) => a.name.localeCompare(b.name));
sortedArtists.forEach(artist => {
  artist.songs.sort((a, b) => a.title.localeCompare(b.title));
});

const totalSongs = songs.length;
---

<!DOCTYPE html>
<html lang="ru" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title} — Песенник</title>
    <meta
      name="description"
      content="Песенник с аккордами: транспонер, автоскролл, тёмная и светлая темы. Работает без интернета."
    />
    <meta name="theme-color" content="#1D2021" />
    <meta name="color-scheme" content="dark light" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Песенник" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" type="image/png" href={`${base}icon-192.png`} />
    <link rel="apple-touch-icon" href={`${base}icon-192.png`} />
    <meta name="generator" content={Astro.generator} />

    <style is:global>
      /* ============================ Design tokens ============================ */
      :root {
        /* System fonts only: no network request, so the sheet renders offline. */
        --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue',
          Arial, sans-serif;
        --font-heading: var(--font-sans);
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

        --transition-smooth: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);

        --tap: 44px; /* minimum comfortable touch target */
        --appbar-height: 52px;
        --radius: 14px;
      }

      /* Gruvbox Dark Theme (Default) */
      html[data-theme='dark'] {
        --bg-main: #1d2021;
        --bg-elevated: #282828;
        --bg-sidebar: #282828;
        --bg-card: rgba(60, 56, 54, 0.55);
        --border-color: rgba(168, 153, 132, 0.18);
        --text-primary: #ebdbb2;
        --text-secondary: #d5c4a1;
        --text-muted: #928374;
        --accent: #fe8019;
        --accent-glow: rgba(254, 128, 25, 0.18);
        --chord-color: #fabd2f;
        --chord-bg: rgba(250, 189, 47, 0.1);
        --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
        --theme-color: #1d2021;
      }

      /* Gruvbox Light Soft Theme */
      html[data-theme='light'] {
        --bg-main: #f2e5bc;
        --bg-elevated: #ebdbb2;
        --bg-sidebar: #ebdbb2;
        --bg-card: rgba(213, 196, 161, 0.55);
        --border-color: rgba(60, 56, 54, 0.14);
        --text-primary: #282828;
        --text-secondary: #3c3836;
        --text-muted: #7c6f64;
        --accent: #458588;
        --accent-glow: rgba(69, 133, 136, 0.1);
        --chord-color: #8f3f71;
        --chord-bg: rgba(143, 63, 113, 0.1);
        --glass-shadow: 0 8px 32px 0 rgba(40, 40, 40, 0.06);
        --theme-color: #f2e5bc;
      }

      /* Gruvbox Warm Sepia / Stage Theme */
      html[data-theme='sepia'] {
        --bg-main: #fbf1c7;
        --bg-elevated: #f9f5d7;
        --bg-sidebar: #f9f5d7;
        --bg-card: rgba(235, 219, 178, 0.6);
        --border-color: rgba(60, 56, 54, 0.14);
        --text-primary: #282828;
        --text-secondary: #3c3836;
        --text-muted: #7c6f64;
        --accent: #af3a03;
        --accent-glow: rgba(175, 58, 3, 0.1);
        --chord-color: #b57614;
        --chord-bg: rgba(181, 118, 20, 0.1);
        --glass-shadow: 0 8px 32px 0 rgba(40, 40, 40, 0.06);
        --theme-color: #fbf1c7;
      }

      /* ================================ Base ================================= */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        -webkit-tap-highlight-color: transparent;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.55;
        background-color: var(--bg-main);
        color: var(--text-primary);
        min-height: 100vh;
        overflow-x: hidden;
        overscroll-behavior-y: none;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input {
        font: inherit;
        color: inherit;
      }

      [hidden] {
        display: none !important;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      /* ============================== App shell ============================== */
      .app-shell {
        display: flex;
        flex-direction: column;
        height: 100vh;
        /* Dynamic viewport height: keeps the layout exact under mobile chrome. */
        height: 100dvh;
      }

      /* ------------------------------- App bar ------------------------------ */
      .app-bar {
        flex: none;
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: calc(var(--appbar-height) + env(safe-area-inset-top));
        padding: env(safe-area-inset-top) 8px 0;
        background: var(--bg-elevated);
        border-bottom: 1px solid var(--border-color);
        position: relative;
        z-index: 20;
      }

      .icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--tap);
        height: var(--tap);
        background: none;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        font-size: 1.25rem;
        line-height: 1;
      }

      .icon-btn:active {
        background: var(--bg-card);
      }

      .app-title {
        flex: 1;
        min-width: 0;
        font-family: var(--font-heading);
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        background: linear-gradient(135deg, var(--accent), var(--chord-color));
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .offline-badge {
        flex: none;
        margin-right: 6px;
        padding: 4px 10px;
        border-radius: 999px;
        border: 1px solid var(--border-color);
        background: var(--bg-card);
        color: var(--text-muted);
        font-size: 0.72rem;
        font-weight: 600;
      }

      /* -------------------------------- Body -------------------------------- */
      .app-body {
        flex: 1;
        display: flex;
        min-height: 0;
        position: relative;
      }

      .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
      }

      .scroll-container {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        padding: 18px 14px calc(32px + env(safe-area-inset-bottom));
      }

      .page-wrapper {
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
      }

      /* ------------------------------- Sidebar ------------------------------ */
      .sidebar {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        width: min(88vw, 340px);
        display: flex;
        flex-direction: column;
        background: var(--bg-sidebar);
        border-right: 1px solid var(--border-color);
        z-index: 40;
        transform: translateX(-102%);
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        visibility: hidden;
      }

      .sidebar.open {
        transform: none;
        visibility: visible;
        box-shadow: var(--glass-shadow);
      }

      .sidebar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 30;
        opacity: 0;
        transition: opacity 0.25s ease;
      }

      .sidebar-backdrop.open {
        opacity: 1;
      }

      .sidebar-header {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: calc(env(safe-area-inset-top) + 10px) 12px 10px;
        border-bottom: 1px solid var(--border-color);
      }

      .logo {
        font-family: var(--font-heading);
        font-size: 1.2rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .search-box {
        flex: none;
        padding: 10px 12px;
        border-bottom: 1px solid var(--border-color);
      }

      .search-input {
        width: 100%;
        min-height: var(--tap);
        padding: 10px 14px;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        font-size: 16px; /* >=16px stops iOS from zooming the page on focus */
        outline: none;
      }

      .search-input:focus {
        border-color: var(--accent);
      }

      .song-list-container {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        padding: 10px 8px;
      }

      .artist-group {
        margin-bottom: 14px;
      }

      .artist-title {
        font-family: var(--font-heading);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        padding: 6px 12px;
      }

      .song-item {
        display: flex;
        align-items: center;
        min-height: var(--tap);
        padding: 10px 12px;
        font-size: 0.98rem;
        border-radius: 10px;
        border-left: 3px solid transparent;
        transition: var(--transition-smooth);
      }

      .song-item:active {
        background: var(--bg-card);
      }

      .song-item.active {
        background: var(--accent-glow);
        color: var(--accent);
        font-weight: 600;
        border-left-color: var(--accent);
      }

      .sidebar-footer {
        flex: none;
        padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
        border-top: 1px solid var(--border-color);
      }

      .theme-toggles {
        display: flex;
        gap: 4px;
        padding: 4px;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 999px;
      }

      .theme-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        min-height: 38px;
        background: none;
        border: none;
        border-radius: 999px;
        cursor: pointer;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-secondary);
        transition: var(--transition-smooth);
      }

      .theme-btn.active {
        background: var(--bg-main);
        color: var(--text-primary);
      }

      .empty-state {
        padding: 32px 16px;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.9rem;
      }

      /* ------------------------------ Desktop ------------------------------- */
      @media (min-width: 900px) {
        .app-shell {
          height: 100vh;
        }

        .app-bar {
          display: none;
        }

        .sidebar {
          position: static;
          width: 320px;
          transform: none;
          visibility: visible;
          flex: none;
        }

        .sidebar-header {
          padding: 20px 20px 16px;
        }

        .sidebar-backdrop {
          display: none;
        }

        .scroll-container {
          padding: 36px 40px 80px;
        }

        .song-list-container {
          padding: 16px 12px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <!-- Compact phone header -->
      <header class="app-bar">
        <button
          class="icon-btn"
          id="open-sidebar"
          aria-label="Список песен"
          aria-controls="sidebar"
          aria-expanded="false"
        >
          ☰
        </button>
        <a class="app-title" href={base}>🎶 Песенник</a>
        <span class="offline-badge" id="offline-badge" hidden>офлайн</span>
        <button class="icon-btn" id="theme-cycle" aria-label="Сменить тему">🌙</button>
      </header>

      <div class="app-body">
        <!-- Sidebar drawer -->
        <aside class="sidebar" id="sidebar" aria-label="Все песни">
          <div class="sidebar-header">
            <a href={base} class="logo"><span>🎶</span> Песенник</a>
            <button class="icon-btn" id="close-sidebar" aria-label="Закрыть список">✕</button>
          </div>

          <div class="search-box">
            <input
              type="search"
              placeholder="Поиск: песня или исполнитель"
              class="search-input"
              id="search-songs"
              data-search-target="#song-list"
              autocomplete="off"
            />
          </div>

          <nav class="song-list-container" id="song-list">
            {sortedArtists.map(artist => (
              <div class="artist-group" data-artist={artist.slug} data-search-group>
                <div class="artist-title">{artist.name}</div>
                {artist.songs.map(song => (
                  <a
                    href={`${base}${song.artistSlug}/${song.songSlug}/`}
                    class={`song-item ${song.artistSlug === activeArtistSlug && song.songSlug === activeSongSlug ? 'active' : ''}`}
                    data-search-item
                    data-search-text={`${song.title} ${song.artist}`.toLowerCase()}
                  >
                    {song.title}
                  </a>
                ))}
              </div>
            ))}
            <div class="empty-state" data-search-empty hidden>Песни не найдены</div>
          </nav>

          <div class="sidebar-footer">
            <div class="theme-toggles">
              <button class="theme-btn" data-theme-target="light" aria-label="Светлая тема">
                ☀️ <span>Светлая</span>
              </button>
              <button class="theme-btn" data-theme-target="dark" aria-label="Тёмная тема">
                🌙 <span>Тёмная</span>
              </button>
              <button class="theme-btn" data-theme-target="sepia" aria-label="Тема для сцены">
                📜 <span>Сцена</span>
              </button>
            </div>
          </div>
        </aside>

        <div class="sidebar-backdrop" id="sidebar-backdrop" hidden></div>

        <!-- Content -->
        <main class="main-content">
          <div class="scroll-container" id="scroll-container">
            <div class="page-wrapper">
              <slot />
            </div>
          </div>
        </main>
      </div>
    </div>

    <script>
      /* ----------------------------- Sidebar drawer ---------------------------- */
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const openBtn = document.getElementById('open-sidebar');
      const closeBtn = document.getElementById('close-sidebar');

      function openSidebar() {
        sidebar?.classList.add('open');
        if (backdrop) backdrop.hidden = false;
        requestAnimationFrame(() => backdrop?.classList.add('open'));
        openBtn?.setAttribute('aria-expanded', 'true');
      }

      function closeSidebar() {
        sidebar?.classList.remove('open');
        backdrop?.classList.remove('open');
        openBtn?.setAttribute('aria-expanded', 'false');
        window.setTimeout(() => {
          if (!sidebar?.classList.contains('open') && backdrop) backdrop.hidden = true;
        }, 250);
      }

      openBtn?.addEventListener('click', openSidebar);
      closeBtn?.addEventListener('click', closeSidebar);
      backdrop?.addEventListener('click', closeSidebar);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeSidebar();
      });
      sidebar?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) closeSidebar();
      });

      /* ---------------------------- Instant search ---------------------------- */
      // Works for any input with data-search-target="<selector>" — the drawer list
      // and the catalog page share this one implementation.
      function attachSearch(input: HTMLInputElement) {
        const scopeSelector = input.getAttribute('data-search-target');
        const scope = scopeSelector ? document.querySelector(scopeSelector) : null;
        if (!scope) return;

        const items = Array.from(scope.querySelectorAll<HTMLElement>('[data-search-item]'));
        // Each search box has its own "nothing found" block next to it.
        const empty = scope.querySelector<HTMLElement>('[data-search-empty]');

        input.addEventListener('input', () => {
          const query = input.value.trim().toLowerCase();
          let visible = 0;

          items.forEach((item) => {
            const haystack = item.getAttribute('data-search-text') || item.textContent || '';
            const match = !query || haystack.toLowerCase().includes(query);
            item.hidden = !match;
            if (match) visible++;

            const group = item.closest<HTMLElement>('[data-search-group]');
            if (group) group.hidden = false;
          });

          scope.querySelectorAll<HTMLElement>('[data-search-group]').forEach((group) => {
            const hasVisible = group.querySelector('[data-search-item]:not([hidden])') !== null;
            group.hidden = !hasVisible;
          });

          if (empty) empty.hidden = visible !== 0;
        });
      }

      document.querySelectorAll<HTMLInputElement>('input[data-search-target]').forEach(attachSearch);

      /* -------------------------------- Themes ------------------------------- */
      const themeButtons = Array.from(document.querySelectorAll<HTMLElement>('[data-theme-target]'));
      const shortThemeIcon = document.getElementById('theme-cycle');
      const themeOrder = ['dark', 'light', 'sepia'] as const;

      function applyTheme(theme: string) {
        document.documentElement.setAttribute('data-theme', theme);
        try {
          localStorage.setItem('theme', theme);
        } catch (error) {
          /* private mode — ignore */
        }
        const color = getComputedStyle(document.documentElement)
          .getPropertyValue('--theme-color')
          .trim();
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', color);
        themeButtons.forEach((btn) => {
          const isActive = btn.getAttribute('data-theme-target') === theme;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-pressed', String(isActive));
        });
        if (shortThemeIcon) {
          shortThemeIcon.textContent = theme === 'dark' ? '🌙' : theme === 'light' ? '☀️' : '📜';
        }
      }

      let savedTheme = 'dark';
      try {
        savedTheme = localStorage.getItem('theme') || 'dark';
      } catch (error) {
        /* ignore */
      }
      applyTheme(savedTheme);

      themeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-theme-target');
          if (target) applyTheme(target);
        });
      });

      shortThemeIcon?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'dark';
        const next = themeOrder[(themeOrder.indexOf(current as (typeof themeOrder)[number]) + 1) % themeOrder.length];
        applyTheme(next);
      });

      /* ------------------------- Drawer scroll memory ------------------------- */
      const songList = document.querySelector<HTMLElement>('.song-list-container');
      const activeSong = document.querySelector<HTMLElement>('.song-item.active');

      if (songList) {
        const savedScrollTop = sessionStorage.getItem('sidebar-scroll-top');
        if (savedScrollTop !== null) {
          songList.scrollTop = parseInt(savedScrollTop, 10);
        } else if (activeSong) {
          activeSong.scrollIntoView({ block: 'nearest' });
        }
        songList.addEventListener('scroll', () => {
          sessionStorage.setItem('sidebar-scroll-top', String(songList.scrollTop));
        });
      }

      /* ---------------------------- Offline plumbing -------------------------- */
      const offlineBadge = document.getElementById('offline-badge');

      function updateNetworkBadge() {
        if (offlineBadge) offlineBadge.hidden = navigator.onLine;
      }

      updateNetworkBadge();
      window.addEventListener('online', updateNetworkBadge);
      window.addEventListener('offline', updateNetworkBadge);

      // The service worker is only generated by a production build.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const swUrl = `${import.meta.env.BASE_URL}sw.js`;
          navigator.serviceWorker.register(swUrl, { scope: import.meta.env.BASE_URL }).catch(() => {
            /* offline cache is optional — the site keeps working online */
          });
        });
      }
    </script>
  </body>
</html>
