---
import { getAllSongs } from '../utils/songParser.js';

interface Props {
  title: string;
  activeArtistSlug?: string;
  activeSongSlug?: string;
}

const { title, activeArtistSlug = '', activeSongSlug = '' } = Astro.props;

const base = import.meta.env.BASE_URL; // '/songs/'

// Fetch all songs for the drawer / navigation
const songs = getAllSongs();

// Group songs by artist
const groupedSongs = songs.reduce((acc, song) => {
  if (!acc[song.artist]) {
    acc[song.artist] = {
      name: song.artist,
      slug: song.artistSlug,
      songs: []
    };
  }
  acc[song.artist].songs.push(song);
  return acc;
}, {} as Record<string, { name: string; slug: string; songs: typeof songs }>);

// Sort artists alphabetically, songs inside each artist too
const sortedArtists = Object.values(groupedSongs).sort((a, b) => a.name.localeCompare(b.name));
sortedArtists.forEach(artist => {
  artist.songs.sort((a, b) => a.title.localeCompare(b.title));
});

const totalSongs = songs.length;
const totalArtists = sortedArtists.length;

// Sort key for the alphabetical index in the sidebar
function sortKey(name: string) {
  const letters = name.replace(/^[«"'(]+/, '');
  return (letters[0] || '#').toUpperCase();
}
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title} — Песенник</title>
    <meta
      name="description"
      content="Песенник с аккордами: транспонер, автоскролл, тёмная и светлая темы. Работает без интернета."
    />
    <meta name="theme-color" content="#0F1113" />
    <meta name="color-scheme" content="dark light" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Песенник" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" type="image/png" href={`${base}icon-192.png`} />
    <link rel="apple-touch-icon" href={`${base}icon-192.png`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme is applied before first paint so the page never flashes. -->
    <script is:inline>
      (function () {
        var theme = 'dark';
        try {
          theme = localStorage.getItem('theme') || theme;
        } catch (error) {
          /* private mode */
        }
        if (!theme || (theme !== 'dark' && theme !== 'light' && theme !== 'sepia')) {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <style is:global>
      /* ============================ Design tokens ============================ */
      :root {
        /* System fonts only: no network request, so the sheet renders offline. */
        --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue',
          Arial, sans-serif;
        --font-display: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia,
          ui-serif, serif;
        --font-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;

        --transition-smooth: color 0.18s ease, background-color 0.18s ease,
          border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;

        --tap: 44px; /* minimum comfortable touch target */
        --appbar-height: 56px;
        --scroll-pad: 22px; /* 1:1 with .scroll-container padding */
        --radius-sm: 10px;
        --radius: 14px;
        --radius-lg: 20px;
      }

      /* --------------------------- Ink (dark) theme -------------------------- */
      html[data-theme='dark'] {
        --bg-main: #0f1113;
        --bg-card: #191d20;
        --bg-elevated: #15181b;
        --bg-sidebar: #14171a;
        --bg-sunken: #0b0d0e;
        --chrome-bg: rgba(15, 17, 19, 0.82);
        --border-color: rgba(236, 233, 227, 0.11);
        --border-strong: rgba(236, 233, 227, 0.2);
        --text-primary: #eceae5;
        --text-secondary: #b3b0a9;
        --text-muted: #83898d;
        --accent: #e8a33d;
        --accent-contrast: #1a1206;
        --accent-glow: rgba(232, 163, 61, 0.16);
        --chord-color: #f0b95e;
        --chord-bg: rgba(232, 163, 61, 0.1);
        --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.5);
        --shadow-md: 0 2px 6px rgba(0, 0, 0, 0.45), 0 18px 40px rgba(0, 0, 0, 0.4);
        --shadow-lg: 0 24px 60px rgba(0, 0, 0, 0.55);
        --theme-color: #0f1113;
      }

      /* --------------------------- Paper (light) theme ----------------------- */
      html[data-theme='light'] {
        --bg-main: #f7f5f1;
        --bg-card: #ffffff;
        --bg-elevated: #fffdfa;
        --bg-sidebar: #f2efe9;
        --bg-sunken: #ece8e1;
        --chrome-bg: rgba(247, 245, 241, 0.84);
        --border-color: rgba(28, 26, 22, 0.12);
        --border-strong: rgba(28, 26, 22, 0.22);
        --text-primary: #1b1a17;
        --text-secondary: #494540;
        --text-muted: #78736b;
        --accent: #b4531f;
        --accent-contrast: #fff6ef;
        --accent-glow: rgba(180, 83, 31, 0.12);
        --chord-color: #9c461a;
        --chord-bg: rgba(180, 83, 31, 0.09);
        --shadow-sm: 0 1px 2px rgba(24, 20, 14, 0.07);
        --shadow-md: 0 2px 6px rgba(24, 20, 14, 0.06), 0 16px 36px rgba(24, 20, 14, 0.07);
        --shadow-lg: 0 24px 60px rgba(24, 20, 14, 0.1);
        --theme-color: #f7f5f1;
      }

      /* ------------------------- Stage (sepia) theme ------------------------- */
      html[data-theme='sepia'] {
        --bg-main: #f3ead4;
        --bg-card: #fdf8ea;
        --bg-elevated: #fbf4e2;
        --bg-sidebar: #eee2c7;
        --bg-sunken: #e7d9ba;
        --chrome-bg: rgba(243, 234, 212, 0.86);
        --border-color: rgba(58, 46, 28, 0.16);
        --border-strong: rgba(58, 46, 28, 0.28);
        --text-primary: #2a2317;
        --text-secondary: #4c4230;
        --text-muted: #7a6c50;
        --accent: #9a5a10;
        --accent-contrast: #fdf8ea;
        --accent-glow: rgba(154, 90, 16, 0.12);
        --chord-color: #8c3f12;
        --chord-bg: rgba(154, 90, 16, 0.1);
        --shadow-sm: 0 1px 2px rgba(48, 38, 20, 0.1);
        --shadow-md: 0 2px 6px rgba(48, 38, 20, 0.08), 0 16px 36px rgba(48, 38, 20, 0.1);
        --shadow-lg: 0 24px 60px rgba(48, 38, 20, 0.14);
        --theme-color: #f3ead4;
      }

      /* ================================ Base ================================= */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        -webkit-tap-highlight-color: transparent;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.55;
        background-color: var(--bg-main);
        color: var(--text-primary);
        min-height: 100vh;
        overflow-x: hidden;
        overscroll-behavior-y: none;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input {
        font: inherit;
        color: inherit;
      }

      ::selection {
        background: var(--accent-glow);
      }

      [hidden] {
        display: none !important;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
        border-radius: 4px;
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      /* ============================== App shell ============================== */
      .app-shell {
        display: flex;
        flex-direction: column;
        height: 100vh;
        /* Dynamic viewport height: keeps the layout exact under mobile chrome. */
        height: 100dvh;
      }

      /* ------------------------------- App bar ------------------------------ */
      .app-bar {
        flex: none;
        display: flex;
        align-items: center;
        gap: 6px;
        min-height: calc(var(--appbar-height) + env(safe-area-inset-top));
        padding: env(safe-area-inset-top) 8px 0;
        background: var(--chrome-bg);
        backdrop-filter: blur(14px) saturate(1.4);
        -webkit-backdrop-filter: blur(14px) saturate(1.4);
        border-bottom: 1px solid var(--border-color);
        position: relative;
        z-index: 20;
      }

      .icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: var(--tap);
        height: var(--tap);
        background: none;
        border: none;
        border-radius: var(--radius-sm);
        cursor: pointer;
        color: var(--text-secondary);
        transition: var(--transition-smooth);
      }

      .icon-btn svg {
        width: 22px;
        height: 22px;
        stroke: currentColor;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
        fill: none;
      }

      .icon-btn:hover {
        color: var(--text-primary);
        background: var(--bg-card);
      }

      .icon-btn:active {
        transform: scale(0.94);
      }

      .app-title {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: baseline;
        gap: 8px;
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--text-primary);
        white-space: nowrap;
      }

      .app-title .brand-mark {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .offline-badge {
        flex: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-right: 4px;
        padding: 4px 10px;
        border-radius: 999px;
        border: 1px solid var(--border-color);
        background: var(--bg-card);
        color: var(--text-muted);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .offline-badge::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
      }

      /* -------------------------------- Body -------------------------------- */
      .app-body {
        flex: 1;
        display: flex;
        min-height: 0;
        position: relative;
      }

      .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
      }

      .scroll-container {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        padding: var(--scroll-pad) 16px calc(40px + env(safe-area-inset-bottom));
        scrollbar-width: thin;
        scrollbar-color: var(--border-strong) transparent;
      }

      .scroll-container::-webkit-scrollbar {
        width: 10px;
        height: 10px;
      }

      .scroll-container::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border: 3px solid transparent;
        background-clip: content-box;
        border-radius: 99px;
      }

      .scroll-container::-webkit-scrollbar-thumb:hover {
        background: var(--border-strong);
        background-clip: content-box;
      }

      .page-wrapper {
        width: 100%;
        max-width: 860px;
        margin: 0 auto;
      }

      /* Any sticky element inside the scroll area can cancel the top padding */
      .pull-to-edge {
        top: calc(var(--scroll-pad) * -1);
      }

      /* ------------------------------- Sidebar ------------------------------ */
      .sidebar {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        width: min(90vw, 350px);
        display: flex;
        flex-direction: column;
        background: var(--bg-sidebar);
        border-right: 1px solid var(--border-color);
        z-index: 40;
        transform: translateX(-102%);
        transition: transform 0.26s cubic-bezier(0.32, 0.72, 0, 1);
        visibility: hidden;
      }

      .sidebar.open {
        transform: none;
        visibility: visible;
        box-shadow: var(--shadow-lg);
      }

      .sidebar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(6, 7, 8, 0.55);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        z-index: 30;
        opacity: 0;
        transition: opacity 0.26s ease;
      }

      .sidebar-backdrop.open {
        opacity: 1;
      }

      .sidebar-header {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: calc(env(safe-area-inset-top) + 12px) 10px 12px 18px;
        border-bottom: 1px solid var(--border-color);
      }

      .logo {
        display: flex;
        flex-direction: column;
        gap: 1px;
        line-height: 1.15;
      }

      .logo .brand-mark {
        font-family: var(--font-mono);
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .logo .brand-name {
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .search-box {
        flex: none;
        position: relative;
        padding: 12px 14px;
      }

      .search-box svg {
        position: absolute;
        left: 27px;
        top: 50%;
        transform: translateY(-50%);
        width: 17px;
        height: 17px;
        stroke: var(--text-muted);
        stroke-width: 1.8;
        fill: none;
        stroke-linecap: round;
        pointer-events: none;
      }

      .search-input {
        width: 100%;
        min-height: var(--tap);
        padding: 10px 14px 10px 40px;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        font-size: 16px; /* >=16px stops iOS from zooming the page on focus */
        color: var(--text-primary);
        outline: none;
        transition: var(--transition-smooth);
        -webkit-appearance: none;
        appearance: none;
      }

      .search-input::placeholder {
        color: var(--text-muted);
      }

      .search-input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-glow);
      }

      .song-list-container {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        padding: 6px 10px 14px;
        scrollbar-width: thin;
        scrollbar-color: var(--border-color) transparent;
      }

      .artist-group {
        margin-bottom: 18px;
      }

      .artist-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--text-muted);
        padding: 8px 10px 6px;
      }

      .artist-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border-color);
      }

      .song-item {
        display: flex;
        align-items: center;
        min-height: 42px;
        padding: 9px 12px;
        font-size: 0.96rem;
        border-radius: var(--radius-sm);
        border-left: 2px solid transparent;
        color: var(--text-secondary);
        transition: var(--transition-smooth);
      }

      .song-item:hover {
        background: var(--bg-card);
        color: var(--text-primary);
      }

      .song-item.active {
        background: var(--accent-glow);
        border-left-color: var(--accent);
        color: var(--text-primary);
        font-weight: 600;
      }

      .sidebar-footer {
        flex: none;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 12px 14px calc(14px + env(safe-area-inset-bottom));
        border-top: 1px solid var(--border-color);
      }

      .sidebar-stats {
        font-size: 0.72rem;
        color: var(--text-muted);
        letter-spacing: 0.02em;
      }

      .theme-toggles {
        display: flex;
        gap: 2px;
        padding: 3px;
        background: var(--bg-main);
        border: 1px solid var(--border-color);
        border-radius: 999px;
      }

      .theme-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 36px;
        padding: 0 6px;
        background: none;
        border: none;
        border-radius: 999px;
        cursor: pointer;
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--text-muted);
        transition: var(--transition-smooth);
      }

      .theme-btn svg {
        width: 15px;
        height: 15px;
        stroke: currentColor;
        stroke-width: 1.7;
        fill: none;
        stroke-linecap: round;
      }

      .theme-btn:hover {
        color: var(--text-secondary);
      }

      .theme-btn.active {
        background: var(--bg-card);
        color: var(--text-primary);
        box-shadow: var(--shadow-sm);
      }

      .empty-state {
        padding: 36px 16px;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.9rem;
      }

      /* ------------------------------ Desktop ------------------------------- */
      @media (min-width: 900px) {
        .app-shell {
          height: 100vh;
        }

        .app-bar {
          display: none;
        }

        .sidebar {
          position: static;
          width: 330px;
          transform: none;
          visibility: visible;
          flex: none;
        }

        .sidebar-header {
          padding: 22px 18px 16px;
        }

        .sidebar-backdrop {
          display: none;
        }

        .scroll-container {
          --scroll-pad: 44px;
          padding: var(--scroll-pad) 48px 96px;
        }

        .song-list-container {
          padding: 8px 14px 18px;
        }
      }

      /* ------------------------------- Print -------------------------------- */
      @media print {
        .app-bar,
        .sidebar,
        .sidebar-backdrop,
        .song-toolbar,
        .video-container,
        .back-link {
          display: none !important;
        }

        .app-shell,
        .app-body,
        .main-content,
        .scroll-container {
          display: block;
          height: auto;
          overflow: visible;
          padding: 0;
        }

        .page-wrapper {
          max-width: none;
        }

        .sheet {
          border: none !important;
          box-shadow: none !important;
          padding: 0 !important;
          background: #fff !important;
        }

        body {
          background: #fff;
          color: #000;
        }

        .chord,
        .lyrics,
        .song-comment {
          color: #000 !important;
          background: none !important;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <!-- Compact phone header -->
      <header class="app-bar">
        <button
          class="icon-btn"
          id="open-sidebar"
          aria-label="Список песен"
          aria-controls="sidebar"
          aria-expanded="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h10" />
          </svg>
        </button>
        <a class="app-title" href={base}>
          <span class="brand-mark">Песенник</span>
        </a>        <span class="offline-badge" id="offline-badge" hidden>офлайн</span>
        <button class="icon-btn" id="theme-cycle" aria-label="Сменить тему">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3v2M12 19v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M3 12h2M19 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            <circle cx="12" cy="12" r="4" />
          </svg>
        </button>
      </header>

      <div class="app-body">
        <!-- Sidebar drawer -->
        <aside class="sidebar" id="sidebar" aria-label="Все песни">
          <div class="sidebar-header">
            <a href={base} class="logo">
              <span class="brand-mark">Songbook</span>
              <span class="brand-name">Песенник</span>
            </a>
            <button class="icon-btn" id="close-sidebar" aria-label="Закрыть список">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>
          </div>

          <div class="search-box">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6" />
              <path d="M20 20l-4.2-4.2" />
            </svg>
            <input
              type="search"
              placeholder="Песня или исполнитель"
              class="search-input"
              id="search-songs"
              data-search-target="#song-list"
              autocomplete="off"
            />
          </div>

          <nav class="song-list-container" id="song-list">
            {sortedArtists.map(artist => (
              <div class="artist-group" data-artist={artist.slug} data-search-group>
                <div class="artist-title">{artist.name}</div>
                {artist.songs.map(song => (
                  <a
                    href={`${base}${song.artistSlug}/${song.songSlug}/`}
                    class={`song-item ${song.artistSlug === activeArtistSlug && song.songSlug === activeSongSlug ? 'active' : ''}`}
                    data-search-item
                    data-search-text={`${song.title} ${song.artist}`.toLowerCase()}
                  >
                    {song.title}
                  </a>
                ))}
              </div>
            ))}
            <div class="empty-state" data-search-empty hidden>Песни не найдены</div>
          </nav>

          <div class="sidebar-footer">
            <div class="sidebar-stats">{totalSongs} песен · {totalArtists} исполнителей</div>
            <div class="theme-toggles">
              <button class="theme-btn" data-theme-target="light" aria-label="Светлая тема">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4" />
                </svg>
                <span>Бумага</span>
              </button>
              <button class="theme-btn" data-theme-target="dark" aria-label="Тёмная тема">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5z" />
                </svg>
                <span>Тушь</span>
              </button>
              <button class="theme-btn" data-theme-target="sepia" aria-label="Тема для сцены">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6 4h9l4 4v12H6z" />
                  <path d="M15 4v4h4M9 12h6M9 16h4" />
                </svg>
                <span>Сцена</span>
              </button>
            </div>
          </div>
        </aside>

        <div class="sidebar-backdrop" id="sidebar-backdrop" hidden></div>

        <!-- Content -->
        <main class="main-content">
          <div class="scroll-container" id="scroll-container">
            <div class="page-wrapper">
              <slot />
            </div>
          </div>
        </main>
      </div>
    </div>

    <script>
      /* ----------------------------- Sidebar drawer ---------------------------- */
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const openBtn = document.getElementById('open-sidebar');
      const closeBtn = document.getElementById('close-sidebar');

      function openSidebar() {
        sidebar?.classList.add('open');
        if (backdrop) backdrop.hidden = false;
        requestAnimationFrame(() => backdrop?.classList.add('open'));
        openBtn?.setAttribute('aria-expanded', 'true');
      }

      function closeSidebar() {
        sidebar?.classList.remove('open');
        backdrop?.classList.remove('open');
        openBtn?.setAttribute('aria-expanded', 'false');
        window.setTimeout(() => {
          if (!sidebar?.classList.contains('open') && backdrop) backdrop.hidden = true;
        }, 260);
      }

      openBtn?.addEventListener('click', openSidebar);
      closeBtn?.addEventListener('click', closeSidebar);
      backdrop?.addEventListener('click', closeSidebar);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeSidebar();
      });
      sidebar?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) closeSidebar();
      });

      /* ---------------------------- Instant search ---------------------------- */
      // Works for any input with data-search-target="<selector>" — the drawer list
      // and the catalog page share this one implementation.
      function attachSearch(input: HTMLInputElement) {
        const scopeSelector = input.getAttribute('data-search-target');
        const scope = scopeSelector ? document.querySelector(scopeSelector) : null;
        if (!scope) return;

        const items = Array.from(scope.querySelectorAll<HTMLElement>('[data-search-item]'));
        // Each search box has its own "nothing found" block next to it.
        const empty = scope.querySelector<HTMLElement>('[data-search-empty]');

        input.addEventListener('input', () => {
          const query = input.value.trim().toLowerCase();
          let visible = 0;

          items.forEach((item) => {
            const haystack = item.getAttribute('data-search-text') || item.textContent || '';
            const match = !query || haystack.toLowerCase().includes(query);
            item.hidden = !match;
            if (match) visible++;
          });

          scope.querySelectorAll<HTMLElement>('[data-search-group]').forEach((group) => {
            const hasVisible = group.querySelector('[data-search-item]:not([hidden])') !== null;
            group.hidden = !hasVisible;
          });

          if (empty) empty.hidden = visible !== 0;
        });
      }

      document.querySelectorAll<HTMLInputElement>('input[data-search-target]').forEach(attachSearch);

      /* -------------------------------- Themes ------------------------------- */
      const themeButtons = Array.from(document.querySelectorAll<HTMLElement>('[data-theme-target]'));
      const shortThemeIcon = document.getElementById('theme-cycle');
      const themeOrder = ['dark', 'light', 'sepia'] as const;
      const themeLabels: Record<string, string> = {
        dark: 'Тёмная тема',
        light: 'Светлая тема',
        sepia: 'Тема для сцены',
      };

      function applyTheme(theme: string) {
        document.documentElement.setAttribute('data-theme', theme);
        try {
          localStorage.setItem('theme', theme);
        } catch (error) {
          /* private mode — ignore */
        }
        const color = getComputedStyle(document.documentElement)
          .getPropertyValue('--theme-color')
          .trim();
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', color);
        themeButtons.forEach((btn) => {
          const isActive = btn.getAttribute('data-theme-target') === theme;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-pressed', String(isActive));
        });
        shortThemeIcon?.setAttribute('aria-label', `Сменить тему (сейчас: ${themeLabels[theme] || theme})`);
      }

      let savedTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      applyTheme(savedTheme);

      themeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-theme-target');
          if (target) applyTheme(target);
        });
      });

      shortThemeIcon?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'dark';
        const next = themeOrder[(themeOrder.indexOf(current as (typeof themeOrder)[number]) + 1) % themeOrder.length];
        applyTheme(next);
      });

      /* ------------------------- Drawer scroll memory ------------------------- */
      const songList = document.querySelector<HTMLElement>('.song-list-container');
      const activeSong = document.querySelector<HTMLElement>('.song-item.active');

      if (songList) {
        const savedScrollTop = sessionStorage.getItem('sidebar-scroll-top');
        if (savedScrollTop !== null) {
          songList.scrollTop = parseInt(savedScrollTop, 10);
        } else if (activeSong) {
          activeSong.scrollIntoView({ block: 'nearest' });
        }
        songList.addEventListener('scroll', () => {
          sessionStorage.setItem('sidebar-scroll-top', String(songList.scrollTop));
        });
      }

      /* ---------------------------- Offline plumbing -------------------------- */
      const offlineBadge = document.getElementById('offline-badge');

      function updateNetworkBadge() {
        if (offlineBadge) offlineBadge.hidden = navigator.onLine;
      }

      updateNetworkBadge();
      window.addEventListener('online', updateNetworkBadge);
      window.addEventListener('offline', updateNetworkBadge);

      // The service worker is only generated by a production build.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const swUrl = `${import.meta.env.BASE_URL}sw.js`;
          navigator.serviceWorker.register(swUrl, { scope: import.meta.env.BASE_URL }).catch(() => {
            /* offline cache is optional — the site keeps working online */
          });
        });
      }
    </script>
  </body>
</html>
