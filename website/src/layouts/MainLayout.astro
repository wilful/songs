---
import { getAllSongs } from '../utils/songParser.js';

interface Props {
  title: string;
  activeArtistSlug?: string;
  activeSongSlug?: string;
}

const { title, activeArtistSlug = '', activeSongSlug = '' } = Astro.props;

// Fetch all songs for the sidebar
const songs = getAllSongs();

// Group songs by artist
const groupedSongs = songs.reduce((acc, song) => {
  if (!acc[song.artist]) {
    acc[song.artist] = {
      name: song.artist,
      slug: song.artistSlug,
      songs: []
    };
  }
  acc[song.artist].songs.push(song);
  return acc;
}, {} as Record<string, { name: string; slug: string; songs: typeof songs }>);

// Sort artists alphabetically
const sortedArtists = Object.values(groupedSongs).sort((a, b) => a.name.localeCompare(b.name));

// Sort songs inside each artist alphabetically
sortedArtists.forEach(artist => {
  artist.songs.sort((a, b) => a.title.localeCompare(b.title));
});
---

<!DOCTYPE html>
<html lang="ru" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Песенник</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    
    <style is:global>
      /* Design Tokens */
      :root {
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-heading: 'Outfit', sans-serif;
        --font-mono: 'Fira Code', monospace;
        
        /* Transition */
        --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* Gruvbox Dark Theme (Default) */
      html[data-theme="dark"] {
        --bg-main: #1D2021; /* Gruvbox Hard Dark */
        --bg-sidebar: rgba(40, 40, 40, 0.85); /* Gruvbox Dark Medium */
        --bg-card: rgba(50, 48, 47, 0.5); /* Gruvbox Dark Soft */
        --border-color: rgba(168, 153, 132, 0.15); /* Gruvbox Gray/Sand */
        --text-primary: #EBDBB2; /* Gruvbox Cream */
        --text-secondary: #D5C4A1;
        --text-muted: #928374; /* Gruvbox Soft Gray */
        --accent: #FE8019; /* Gruvbox Orange */
        --accent-glow: rgba(254, 128, 25, 0.15);
        --chord-color: #FABD2F; /* Gruvbox Gold/Yellow */
        --chord-bg: rgba(250, 189, 47, 0.08);
        --glass-bg: rgba(40, 40, 40, 0.7);
        --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
      }

      /* Gruvbox Light Soft Theme */
      html[data-theme="light"] {
        --bg-main: #F2E5BC; /* Soft Warm Sand */
        --bg-sidebar: rgba(235, 219, 178, 0.85);
        --bg-card: rgba(213, 196, 161, 0.5);
        --border-color: rgba(60, 56, 54, 0.12);
        --text-primary: #282828; /* Gruvbox Dark Charcoal */
        --text-secondary: #3C3836;
        --text-muted: #7C6F64;
        --accent: #458588; /* Gruvbox Blue */
        --accent-glow: rgba(69, 133, 136, 0.08);
        --chord-color: #8F3F71; /* Gruvbox Purple */
        --chord-bg: rgba(143, 63, 113, 0.08);
        --glass-bg: rgba(235, 219, 178, 0.8);
        --glass-shadow: 0 8px 32px 0 rgba(40, 40, 40, 0.06);
      }

      /* Gruvbox Warm Sepia / Stage Theme */
      html[data-theme="sepia"] {
        --bg-main: #FBF1C7; /* Medium Warm Paper */
        --bg-sidebar: rgba(249, 245, 215, 0.9);
        --bg-card: rgba(235, 219, 178, 0.6);
        --border-color: rgba(60, 56, 54, 0.12);
        --text-primary: #282828;
        --text-secondary: #3C3836;
        --text-muted: #7C6F64;
        --accent: #AF3A03; /* Deep Rust Orange */
        --accent-glow: rgba(175, 58, 3, 0.08);
        --chord-color: #B57614; /* Warm Gold */
        --chord-bg: rgba(181, 118, 20, 0.08);
        --glass-bg: rgba(249, 245, 215, 0.8);
        --glass-shadow: 0 8px 32px 0 rgba(40, 40, 40, 0.06);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--bg-main);
        color: var(--text-primary);
        min-height: 100vh;
        display: flex;
        overflow-x: hidden;
        transition: var(--transition-smooth);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      /* Custom scrollbars */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--text-muted);
      }

      /* Basic Layout Styling */
      .app-container {
        display: flex;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        position: relative;
      }

      /* Sidebar styling */
      .sidebar {
        width: 320px;
        height: 100%;
        background-color: var(--bg-sidebar);
        border-right: 1px solid var(--border-color);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        display: flex;
        flex-direction: column;
        transition: var(--transition-smooth);
        z-index: 100;
        flex-shrink: 0;
      }

      .sidebar-header {
        padding: 24px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        background: linear-gradient(135deg, var(--accent), var(--chord-color));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .search-box {
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-color);
      }

      .search-input {
        width: 100%;
        padding: 10px 16px;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        color: var(--text-primary);
        font-family: var(--font-sans);
        font-size: 0.9rem;
        outline: none;
        transition: var(--transition-smooth);
      }

      .search-input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 2px var(--accent-glow);
      }

      .song-list-container {
        flex: 1;
        overflow-y: auto;
        padding: 16px 12px;
      }

      .artist-group {
        margin-bottom: 20px;
      }

      .artist-title {
        font-family: var(--font-heading);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        padding-left: 12px;
        margin-bottom: 8px;
      }

      .song-item {
        display: block;
        padding: 8px 12px;
        font-size: 0.9rem;
        border-radius: 8px;
        margin-bottom: 2px;
        transition: var(--transition-smooth);
        border-left: 2px solid transparent;
      }

      .song-item:hover {
        background: var(--bg-card);
        padding-left: 16px;
      }

      .song-item.active {
        background: var(--accent-glow);
        color: var(--accent);
        font-weight: 500;
        border-left-color: var(--accent);
      }

      /* Content Area */
      .main-content {
        flex: 1;
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .top-navbar {
        height: 56px;
        padding: 0 16px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--bg-sidebar);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        z-index: 90;
      }

      @media (min-width: 769px) {
        .top-navbar {
          display: none;
        }
      }

      .menu-toggle {
        display: none;
        background: none;
        border: none;
        color: var(--text-primary);
        font-size: 1.5rem;
        cursor: pointer;
        padding: 4px;
        line-height: 1;
      }

      .navbar-title {
        font-family: var(--font-heading);
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        background: linear-gradient(135deg, var(--accent), var(--chord-color));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .navbar-spacer {
        width: 32px;
      }

      .sidebar-footer {
        padding: 12px 16px;
        border-top: 1px solid var(--border-color);
        background: rgba(0, 0, 0, 0.1);
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .theme-toggles {
        display: flex;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        padding: 3px;
        border-radius: 9999px;
        gap: 4px;
        width: 100%;
      }

      .theme-btn {
        background: none;
        border: none;
        flex: 1;
        padding: 6px 0;
        border-radius: 9999px;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--text-secondary);
        transition: var(--transition-smooth);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
      }

      .theme-btn.active {
        background: var(--bg-main);
        color: var(--text-primary);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      }

      .scroll-container {
        flex: 1;
        overflow-y: auto;
        padding: 40px;
        display: flex;
        justify-content: center;
      }

      .page-wrapper {
        width: 100%;
        max-width: 800px;
      }

      /* Responsive styling */
      @media (max-width: 768px) {
        .sidebar {
          position: absolute;
          left: -320px;
          top: 0;
          bottom: 0;
          box-shadow: var(--glass-shadow);
        }

        .sidebar.open {
          left: 0;
        }

        .menu-toggle {
          display: block;
        }

        .scroll-container {
          padding: 24px 16px;
        }
      }
    </style>
  </head>
  <body>
    <div class="app-container">
      <!-- Sidebar Drawer -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
          <a href="/songs/" class="logo">
            <span>🎶</span> Songbook
          </a>
          <button class="menu-toggle" id="close-sidebar" aria-label="Close menu">✕</button>
        </div>
        
        <div class="search-box">
          <input 
            type="text" 
            placeholder="Поиск песен..." 
            class="search-input" 
            id="search-songs" 
            autocomplete="off"
          />
        </div>

        <nav class="song-list-container">
          {sortedArtists.map(artist => (
            <div class="artist-group" data-artist={artist.slug}>
              <div class="artist-title">{artist.name}</div>
              {artist.songs.map(song => (
                <a 
                  href={`/songs/${song.artistSlug}/${song.songSlug}/`} 
                  class={`song-item ${song.artistSlug === activeArtistSlug && song.songSlug === activeSongSlug ? 'active' : ''}`}
                  data-title={song.title.toLowerCase()}
                  data-artist-name={song.artist.toLowerCase()}
                >
                  {song.title}
                </a>
              ))}
            </div>
          ))}
          <div id="no-songs-found" style="display: none; padding: 24px; text-align: center; color: var(--text-muted); font-size: 0.9rem;">
            Песни не найдены
          </div>
        </nav>
        
        <!-- Theme Controls in Sidebar Footer -->
        <div class="sidebar-footer">
          <div class="theme-toggles">
            <button class="theme-btn" data-theme-target="light" title="Светлая тема">
              ☀️ <span>Светлая</span>
            </button>
            <button class="theme-btn" data-theme-target="dark" title="Темная тема">
              🌙 <span>Темная</span>
            </button>
            <button class="theme-btn" data-theme-target="sepia" title="Теплый режим сцены">
              📜 <span>Сцена</span>
            </button>
          </div>
        </div>
      </aside>

      <!-- Main Layout Panel -->
      <main class="main-content">
        <header class="top-navbar">
          <button class="menu-toggle" id="open-sidebar" aria-label="Open menu">☰</button>
          
          <div class="navbar-title">
            🎶 Songbook
          </div>
          
          <div class="navbar-spacer"></div>
        </header>

        <div class="scroll-container" id="scroll-container">
          <div class="page-wrapper">
            <slot />
          </div>
        </div>
      </main>
    </div>

    <!-- Client-Side Navigation and Search Logic -->
    <script>
      // Sidebar Toggles
      const openBtn = document.getElementById('open-sidebar');
      const closeBtn = document.getElementById('close-sidebar');
      const sidebar = document.getElementById('sidebar');

      openBtn?.addEventListener('click', () => sidebar?.classList.add('open'));
      closeBtn?.addEventListener('click', () => sidebar?.classList.remove('open'));

      // Close sidebar when clicking outside on mobile
      document.addEventListener('click', (e) => {
        if (window.innerWidth <= 768) {
          const target = e.target as HTMLElement;
          if (sidebar && sidebar.classList.contains('open') && !sidebar.contains(target) && target !== openBtn) {
            sidebar.classList.remove('open');
          }
        }
      });

      // Local Instant Search Logic
      const searchInput = document.getElementById('search-songs') as HTMLInputElement;
      const songItems = document.querySelectorAll('.song-item');
      const artistGroups = document.querySelectorAll('.artist-group');
      const noSongsFound = document.getElementById('no-songs-found');

      searchInput?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        let visibleSongs = 0;

        artistGroups.forEach(group => {
          const itemsInGroup = group.querySelectorAll('.song-item');
          let groupHasVisibleSongs = false;

          itemsInGroup.forEach(item => {
            const title = item.getAttribute('data-title') || '';
            const artist = item.getAttribute('data-artist-name') || '';

            if (title.includes(query) || artist.includes(query)) {
              (item as HTMLElement).style.display = 'block';
              groupHasVisibleSongs = true;
              visibleSongs++;
            } else {
              (item as HTMLElement).style.display = 'none';
            }
          });

          // Show/hide artist header based on whether there are visible songs
          if (groupHasVisibleSongs) {
            (group as HTMLElement).style.display = 'block';
          } else {
            (group as HTMLElement).style.display = 'none';
          }
        });

        // Toggle "No songs found" box
        if (noSongsFound) {
          noSongsFound.style.display = visibleSongs === 0 ? 'block' : 'none';
        }
      });

      // Persistent Theme Handler
      const themeBtns = document.querySelectorAll('[data-theme-target]');
      const rootHtml = document.documentElement;

      // Read saved theme
      const savedTheme = localStorage.getItem('theme') || 'dark';
      rootHtml.setAttribute('data-theme', savedTheme);
      updateActiveThemeButton(savedTheme);

      themeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetTheme = btn.getAttribute('data-theme-target');
          if (targetTheme) {
            rootHtml.setAttribute('data-theme', targetTheme);
            localStorage.setItem('theme', targetTheme);
            updateActiveThemeButton(targetTheme);
          }
        });
      });

      function updateActiveThemeButton(theme: string) {
        themeBtns.forEach(btn => {
          if (btn.getAttribute('data-theme-target') === theme) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
      }
    </script>
  </body>
</html>
