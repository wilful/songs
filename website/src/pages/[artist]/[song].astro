---
import MainLayout from '../../layouts/MainLayout.astro';
import SongDock from '../../components/SongDock.astro';
import { getAllSongs } from '../../utils/songParser.js';

export async function getStaticPaths() {
  const songs = getAllSongs();
  return songs.map(song => ({
    params: { artist: song.artistSlug, song: song.songSlug },
    props: { song }
  }));
}

const { song } = Astro.props;
const base = import.meta.env.BASE_URL; // '/songs/'

const slug = `${song.artistSlug}/${song.songSlug}`;
const isMinor = /m$/i.test(song.key || '');
const presetKeys = isMinor
  ? ['Am', 'Em', 'Dm', 'F#m', 'Bm', 'Gm', 'Cm']
  : ['C', 'G', 'D', 'A', 'E', 'F', 'B'];
const speedChoices = [
  { index: 0, label: '0.25×' },
  { index: 1, label: '0.5×' },
  { index: 2, label: '1×' },
  { index: 3, label: '2×' },
  { index: 4, label: '3×' },
  { index: 5, label: '5×' }
];
const frets = Array.from({ length: 12 }, (_, index) => index);

// Капо из метаданных песни: положение зажима на грифе.
const capoBase = parseInt(song.capo, 10);
const hasCapo = Number.isFinite(capoBase) && capoBase > 0;
---

<MainLayout
  title={`${song.artist} — ${song.title}`}
  backHref={base}
  barTitle={song.artist}
  songSlug={slug}
  activeArtistSlug={song.artistSlug}
  activeSongSlug={song.songSlug}
>
  <Fragment slot="bar-actions">
    <button
      class="icon-btn"
      data-fav={slug}
      aria-label="В избранное"
      aria-pressed="false"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 4.2l2.4 5 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4-3.9-3.8 5.4-.8z"
        ></path>
      </svg>
    </button>
  </Fragment>

  <article class="song">
    <header class="song-head">
      <h1 class="song-title">{song.title}</h1>
      <p class="song-meta">
        {song.artist}
        {song.tempo && <span class="dot">·</span>}
        {song.tempo && <span>{song.tempo} bpm</span>}
      </p>
    </header>

    <!-- Каподастр: тональность, лады и положение зажима -->
    <button
      class="capo"
      id="capo-strip"
      aria-haspopup="dialog"
      aria-label="Тональность и капо — открыть настройки"
      data-base-capo={hasCapo ? String(capoBase) : '0'}
    >
      {song.key && <span class="capo-key" id="capo-key">{song.key}</span>}
      <span class="capo-ruler" aria-hidden="true">
        <span class="capo-neck"></span>
        <span class="capo-ticks">
          {frets.map(fret => (
            <span class="capo-tick" style={`left:${(fret / 12) * 100}%`} />
          ))}
        </span>
        <span
          class="capo-marker"
          id="capo-marker"
          style={`left:${(capoBase / 12) * 100}%`}
        >
        </span>
      </span>
      <span class="capo-meta" id="capo-meta">
        {hasCapo ? `капо ${capoBase}` : 'без сдвига'}
      </span>
      <svg class="capo-caret" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 10l4 4 4-4" />
      </svg>
    </button>

    <section class="sheet" id="sheet">
      <Fragment set:html={song.html} />
    </section>

    {song.videoUrl && (
      <section class="video">
        <div class="video-head">
          <h2 class="video-title">Видеоразбор и клип</h2>
          <a href={song.videoUrl} target="_blank" rel="noopener noreferrer" class="video-link">
            Открыть на YouTube
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 16l8-8M10 8h6v6" />
            </svg>
          </a>
        </div>
        <div class="video-frame">
          {song.videoUrl.includes('youtube.com') || song.videoUrl.includes('youtu.be') ? (
            (() => {
              const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
              const match = song.videoUrl.match(regExp);
              const youtubeId = match && match[2].length === 11 ? match[2] : null;
              return youtubeId ? (
                <iframe
                  width="100%"
                  src={`https://www.youtube.com/embed/${youtubeId}`}
                  title="Видеоразбор песни"
                  frameborder="0"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  class="video-iframe"
                ></iframe>
              ) : (
                <div class="video-fallback">Не удалось загрузить плеер</div>
              );
            })()
          ) : (
            <div class="video-fallback">Видео по внешней ссылке</div>
          )}
        </div>
      </section>
    )}
  </article>

  <Fragment slot="dock">
    <SongDock slug={slug} />
  </Fragment>

  <!-- Панель настройки тональности и прокрутки -->
  <dialog class="tune" id="tune-sheet">
    <div class="tune-head">
      <h2 class="tune-title">Тональность</h2>
      <button class="icon-btn" id="tune-close" aria-label="Закрыть">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <div class="tune-body">
      <div class="tune-now">
        {song.key ? (
          <>
            <span class="tune-orig" id="tune-orig">{song.key}</span>
            <span class="tune-arrow" aria-hidden="true">→</span>
            <span class="tune-current" id="tune-current">{song.key}</span>
          </>
        ) : (
          <span class="tune-hint">У песни не указана тональность — сдвигайте аккорды вручную.</span>
        )}
      </div>

      {song.key && (
        <>
          <div class="key-grid">
            {presetKeys.map(key => (
              <button class="key-btn" data-key={key}>
                {key}
              </button>
            ))}
          </div>
          <button class="tune-reset" id="tune-reset">Вернуть исходную тональность</button>
        </>
      )}

      <div class="tune-row">
        <span class="tune-label">Скорость прокрутки</span>
        <div class="speed-grid" id="speed-seg">
          {speedChoices.map(choice => (
            <button class="speed-btn" data-speed={choice.index}>{choice.label}</button>
          ))}
        </div>
      </div>
    </div>
  </dialog>
</MainLayout>

<style is:global>
  /* =============================== Лист песни ============================== */
  .song {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .song-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .song-title {
    font-size: clamp(1.6rem, 7vw, 2.1rem);
    font-weight: 750;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .song-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .song-meta .dot {
    color: var(--line-strong);
  }

  /* ============================== Каподастр =============================== */
  .capo {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 12px 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }

  .capo:hover {
    border-color: var(--line-strong);
  }

  .capo-key {
    flex: none;
    min-width: 52px;
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .capo-ruler {
    position: relative;
    flex: 1;
    min-width: 60px;
    height: 34px;
  }

  .capo-neck {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 2px;
    border-radius: 2px;
    background: var(--line-strong);
  }

  .capo-ticks {
    position: absolute;
    inset: 0;
  }

  .capo-tick {
    position: absolute;
    bottom: 8px;
    width: 1px;
    height: 7px;
    background: var(--line-strong);
  }

  .capo-marker {
    position: absolute;
    bottom: 0;
    width: 14px;
    height: 22px;
    margin-left: -7px;
    border-radius: 4px;
    background: var(--accent);
    transition: left 0.24s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .capo-meta {
    flex: none;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .capo-caret {
    flex: none;
    width: 16px;
    height: 16px;
    stroke: var(--ink-3);
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ================================ Текст ================================= */
  .sheet {
    font-size: calc(1.12rem * var(--sheet-scale, 1));
    color: var(--ink);
  }

  .song-section + .song-section {
    margin-top: 26px;
  }

  .song-section-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    color: var(--ink-3);
  }

  .song-section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .song-paragraph + .song-paragraph {
    margin-top: 18px;
  }

  .song-line {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    line-height: 2.05;
  }

  .song-line.tab-line {
    font-family: var(--font-mono);
    font-size: 0.78em;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    white-space: pre-wrap;
  }

  .chord-lyrics-pair {
    display: inline-flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .chord {
    font-family: var(--font-mono);
    font-size: 0.8em;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin-bottom: 0.4em;
    color: var(--accent);
    user-select: none;
  }

  .lyrics {
    font-size: 1em;
    color: var(--ink);
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  .song-comment {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-3);
  }

  .song-comment::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  /* ================================ Видео ================================= */
  .video {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 6px;
  }

  .video-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .video-title {
    font-size: 1rem;
    font-weight: 650;
    color: var(--ink);
  }

  .video-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
  }

  .video-link svg {
    width: 15px;
    height: 15px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--r);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .video-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .video-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--ink-3);
    font-size: 0.9rem;
  }

  /* ============================ Панель настроек ============================ */
  .tune {
    position: fixed;
    inset: auto 0 0 0;
    margin: 0 auto;
    width: 100%;
    max-width: 520px;
    max-height: 84dvh;
    padding: 0 0 env(safe-area-inset-bottom);
    border: none;
    border-radius: 20px 20px 0 0;
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
    overflow-y: auto;
  }

  dialog.tune::backdrop {
    background: rgba(4, 8, 12, 0.55);
  }

  .tune[open] {
    animation: tune-in 0.22s cubic-bezier(0.32, 0.72, 0, 1);
  }

  @keyframes tune-in {
    from {
      transform: translateY(18px);
      opacity: 0.4;
    }
  }

  .tune-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 10px 8px 20px;
    border-bottom: 1px solid var(--line);
  }

  .tune-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .tune-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 18px 20px 22px;
  }

  .tune-now {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .tune-orig {
    color: var(--ink-3);
  }

  .tune-arrow {
    color: var(--line-strong);
  }

  .tune-current {
    color: var(--accent);
  }

  .tune-hint {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-3);
  }

  .key-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(64px, 1fr));
    gap: 8px;
  }

  .key-btn {
    min-height: 46px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink-2);
    transition: color 0.16s ease, border-color 0.16s ease, background-color 0.16s ease;
  }

  .key-btn:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .key-btn.active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .tune-reset {
    min-height: 46px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: none;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .tune-reset:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .tune-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tune-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-3);
  }

  .speed-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .speed-btn {
    min-height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-2);
    transition: color 0.16s ease, border-color 0.16s ease, background-color 0.16s ease;
  }

  .speed-btn:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .speed-btn.active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  /* =============================== Десктоп ================================ */
  @media (min-width: 900px) {
    .song {
      gap: 26px;
    }

    .sheet {
      font-size: calc(1.16rem * var(--sheet-scale, 1));
    }

    .song-body {
      column-count: 2;
      column-gap: 44px;
    }

    .song-section {
      break-inside: avoid;
    }
  }
</style>

<script>
  import { getOffset, setOffset, onOffset, transposeKey, keyDistance } from '../../utils/chords.js';
  import { getSpeedIndex, setSpeedIndex } from '../../utils/player.js';
  import { pushRecent } from '../../utils/store.js';

  const originalKey = document.getElementById('tune-orig')?.textContent?.trim() || '';
  const capoKey = document.getElementById('capo-key');
  const capoMeta = document.getElementById('capo-meta');
  const capoMarker = document.getElementById('capo-marker');
  const tuneCurrent = document.getElementById('tune-current');
  const tuneDialog = document.getElementById('tune-sheet') as HTMLDialogElement | null;
  const strip = document.getElementById('capo-strip');
  const baseCapo = Number(strip?.getAttribute('data-base-capo') || 0);
  const hasCapo = baseCapo > 0;

  pushRecent(document.body.dataset.songSlug || '');

  function paintTone(offset: number) {
    const current = originalKey ? transposeKey(originalKey, offset) : '';
    if (capoKey) capoKey.textContent = current || '—';
    if (tuneCurrent) tuneCurrent.textContent = current || '—';
    if (capoMeta) {
      if (hasCapo) {
        capoMeta.textContent = `капо ${Math.min(11, Math.max(0, baseCapo + offset))}`;
      } else if (offset === 0) {
        capoMeta.textContent = 'без сдвига';
      } else {
        capoMeta.textContent = `сдвиг ${offset > 0 ? '+' : '−'}${Math.abs(offset)}`;
      }
    }
    if (capoMarker) {
      // Зажим по грифу: у капованной песни — сам капо, иначе — сдвиг на полутон.
      const position = hasCapo
        ? Math.min(11, Math.max(0, baseCapo + offset))
        : ((offset % 12) + 12) % 12;
      capoMarker.style.left = `${(position / 12) * 100}%`;
    }

    document.querySelectorAll<HTMLElement>('.key-btn').forEach(btn => {
      const key = btn.getAttribute('data-key') || '';
      btn.classList.toggle('active', key !== '' && current === key);
    });
  }

  onOffset(paintTone);
  paintTone(getOffset());

  /* --------------------------- Панель настроек --------------------------- */
  function openTune() {
    if (!tuneDialog) return;
    if (typeof tuneDialog.showModal === 'function') tuneDialog.showModal();
    else tuneDialog.setAttribute('open', '');
  }

  function closeTune() {
    if (!tuneDialog) return;
    if (typeof tuneDialog.close === 'function') tuneDialog.close();
    else tuneDialog.removeAttribute('open');
  }

  strip?.addEventListener('click', openTune);
  document.getElementById('tune-close')?.addEventListener('click', closeTune);

  tuneDialog?.addEventListener('click', event => {
    if (event.target === tuneDialog) closeTune();
  });

  document.getElementById('tune-reset')?.addEventListener('click', () => {
    setOffset(0);
    closeTune();
  });

  document.querySelectorAll<HTMLElement>('.key-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-key') || '';
      if (!key || !originalKey) return;
      setOffset(keyDistance(originalKey, key));
    });
  });

  /* ---------------------------- Скорость прокрутки ------------------------ */
  function paintSpeed() {
    const current = getSpeedIndex();
    document.querySelectorAll<HTMLElement>('#speed-seg .speed-btn').forEach(btn => {
      const index = parseInt(btn.getAttribute('data-speed') || '', 10);
      btn.classList.toggle('active', index === current);
      btn.setAttribute('aria-pressed', String(index === current));
    });
  }

  document.querySelectorAll<HTMLElement>('#speed-seg .speed-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const index = parseInt(btn.getAttribute('data-speed') || '', 10);
      if (!Number.isNaN(index)) setSpeedIndex(index);
      paintSpeed();
    });
  });

  paintSpeed();
</script>
