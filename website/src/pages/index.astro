---
import MainLayout from '../layouts/MainLayout.astro';
import { getAllSongs } from '../utils/songParser.js';

const base = import.meta.env.BASE_URL; // '/songs/'

const songs = getAllSongs();
const totalSongs = songs.length;
const totalArtists = new Set(songs.map(s => s.artist)).size;

// Group songs by artist for the catalog
const groupedSongs = songs.reduce((acc, song) => {
  if (!acc[song.artist]) {
    acc[song.artist] = {
      name: song.artist,
      slug: song.artistSlug,
      songs: []
    };
  }
  acc[song.artist].songs.push(song);
  return acc;
}, {} as Record<string, { name: string; slug: string; songs: typeof songs }>);

const sortedArtists = Object.values(groupedSongs).sort((a, b) => a.name.localeCompare(b.name));
sortedArtists.forEach(artist => {
  artist.songs.sort((a, b) => a.title.localeCompare(b.title));
});
---

<MainLayout title="Все песни">
  <div class="catalog">
    <header class="catalog-hero">
      <p class="eyebrow">Домашний песенник</p>
      <h1 class="catalog-title">Песни с аккордами</h1>
      <p class="catalog-subtitle">
        {totalSongs} песен · {totalArtists} исполнителей · чтение без интернета
      </p>
    </header>

    <div class="search-row">
      <label class="search-field">
        <span class="visually-hidden">Поиск по песням и исполнителям</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6" />
          <path d="M20 20l-4.2-4.2" />
        </svg>
        <input
          type="search"
          id="catalog-search"
          class="search-input"
          placeholder="Песня или исполнитель"
          data-search-target="#catalog-list"
          autocomplete="off"
          enterkeyhint="search"
        />
      </label>
    </div>

    <div id="catalog-list" class="catalog-list">
      {sortedArtists.map(artist => (
        <section class="artist-card" data-search-group>
          <h2 class="artist-heading">
            <span class="artist-name">{artist.name}</span>
            <span class="artist-count">{artist.songs.length}</span>
          </h2>
          <ul class="song-rows">
            {artist.songs.map(song => (
              <li>
                <a
                  class="song-row"
                  href={`${base}${song.artistSlug}/${song.songSlug}/`}
                  data-search-item
                  data-search-text={`${song.title} ${artist.name}`.toLowerCase()}
                >
                  <span class="song-row-title">{song.title}</span>
                  <span class="song-row-meta">
                    {song.key && <span class="chip">{song.key}</span>}
                    <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M9 6l6 6-6 6" />
                    </svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <div class="empty-state" data-search-empty hidden>
        Ничего не нашлось. Попробуйте другое слово.
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .catalog {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .catalog-hero {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 4px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .catalog-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .catalog-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Search stays reachable while scrolling the long list */
  .search-row {
    position: sticky;
    top: calc(var(--scroll-pad) * -1);
    z-index: 5;
    padding: 12px 0;
    background: linear-gradient(var(--bg-main) 72%, transparent);
  }

  .search-field {
    position: relative;
    display: block;
  }

  .search-field svg {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    width: 17px;
    height: 17px;
    stroke: var(--text-muted);
    stroke-width: 1.8;
    fill: none;
    stroke-linecap: round;
    pointer-events: none;
  }

  .search-field .search-input {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }

  .search-field .search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .catalog-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .artist-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .artist-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 18px 12px;
    border-bottom: 1px solid var(--border-color);
    background: linear-gradient(var(--bg-elevated), transparent);
  }

  .artist-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .artist-count {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 3px 9px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
  }

  .song-rows {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .song-rows li + li .song-row {
    border-top: 1px solid var(--border-color);
  }

  .song-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: var(--tap);
    padding: 12px 18px;
    transition: var(--transition-smooth);
  }

  .song-row:active,
  .song-row:hover {
    background: var(--accent-glow);
  }

  .song-row-title {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .song-row-meta {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .chip {
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    background: var(--chord-bg);
    color: var(--chord-color);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .arrow {
    width: 16px;
    height: 16px;
    stroke: var(--text-muted);
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: var(--transition-smooth);
  }

  .song-row:hover .arrow {
    stroke: var(--accent);
    transform: translateX(2px);
  }

  @media (min-width: 900px) {
    .catalog-title {
      font-size: 2.5rem;
    }

    .catalog-hero {
      padding-top: 0;
    }

    .catalog-list {
      column-count: 2;
      column-gap: 22px;
      display: block;
    }

    .artist-card {
      display: inline-block;
      width: 100%;
      margin-bottom: 22px;
      break-inside: avoid;
    }
  }
</style>
