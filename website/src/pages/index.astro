---
import MainLayout from '../layouts/MainLayout.astro';
import { getAllSongs } from '../utils/songParser.js';

const base = import.meta.env.BASE_URL; // '/songs/'

const songs = getAllSongs();

const KEY_ORDER = ['C', 'G', 'D', 'A', 'E', 'F', 'B', 'Am', 'Em', 'Dm', 'F#m', 'Bm', 'Gm', 'Cm'];

function keyRank(key: string) {
  const index = KEY_ORDER.indexOf(key);
  return index === -1 ? KEY_ORDER.length : index;
}

const byArtist = new Map<string, typeof songs>();
for (const song of songs) {
  if (!byArtist.has(song.artist)) byArtist.set(song.artist, []);
  byArtist.get(song.artist)!.push(song);
}
const artists = Array.from(byArtist.entries())
  .map(([name, list]) => ({
    name,
    songs: list.sort((a, b) => a.title.localeCompare(b.title))
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const byKey = new Map<string, typeof songs>();
for (const song of songs) {
  const key = song.key || '—';
  if (!byKey.has(key)) byKey.set(key, []);
  byKey.get(key)!.push(song);
}
const keys = Array.from(byKey.entries())
  .map(([name, list]) => ({
    name,
    songs: list.sort((a, b) => a.artist.localeCompare(b.artist) || a.title.localeCompare(b.title))
  }))
  .sort((a, b) => keyRank(a.name) - keyRank(b.name) || a.name.localeCompare(b.name));

const chipKeys = keys.filter(item => item.name !== '—').map(item => item.name);
---

<MainLayout title="Все песни">
  <div class="home">
    <div class="search-row">
      <label class="search-field">
        <span class="visually-hidden">Поиск по песням и исполнителям</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6" />
          <path d="M20 20l-4.2-4.2" />
        </svg>
        <input
          type="search"
          id="catalog-search"
          class="search-input"
          placeholder="Песня, исполнитель или тональность"
          autocomplete="off"
          enterkeyhint="search"
        />
      </label>
    </div>

    <div class="switch" role="group" aria-label="Список песен">
      <button class="switch-btn active" data-view="artist">По исполнителю</button>
      <button class="switch-btn" data-view="key">По тональности</button>
    </div>

    <div class="chips" id="key-chips">
      {chipKeys.map(key => (
        <button class="chip" data-key={key}>{key}</button>
      ))}
    </div>

    <section class="block" id="recent-block" hidden>
      <h2 class="block-label">Недавние</h2>
      <ul class="rows" id="recent-rows"></ul>
    </section>

    <section class="block" id="fav-block" hidden>
      <h2 class="block-label">Избранное</h2>
      <ul class="rows" id="fav-rows"></ul>
    </section>

    <div class="view" id="view-artist">
      {artists.map(artist => (
        <section class="group" data-search-group>
          <h2 class="group-label">{artist.name}</h2>
          <ul class="rows">
            {artist.songs.map(song => (
              <li
                class="row"
                data-search-item
                data-search-text={`${song.title} ${song.artist} ${song.key}`.toLowerCase()}
                data-key={song.key}
                data-slug={`${song.artistSlug}/${song.songSlug}`}
              >
                <a class="row-link" href={`${base}${song.artistSlug}/${song.songSlug}/`}>
                  <span class="row-title">{song.title}</span>
                  <span class="row-artist">{song.artist}</span>
                </a>
                {song.key && <span class="row-key">{song.key}</span>}
                <button
                  class="fav"
                  data-fav={`${song.artistSlug}/${song.songSlug}`}
                  aria-label="В избранное"
                  aria-pressed="false"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 4.2l2.4 5 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4-3.9-3.8 5.4-.8z"></path>
                  </svg>
                </button>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="view" id="view-key" hidden>
      {keys.map(group => (
        <section class="group" data-search-group>
          <h2 class="group-label">{group.name === '—' ? 'Без тональности' : group.name}</h2>
          <ul class="rows">
            {group.songs.map(song => (
              <li
                class="row"
                data-search-item
                data-search-text={`${song.title} ${song.artist} ${song.key}`.toLowerCase()}
                data-key={song.key}
                data-slug={`${song.artistSlug}/${song.songSlug}`}
              >
                <a class="row-link" href={`${base}${song.artistSlug}/${song.songSlug}/`}>
                  <span class="row-title">{song.title}</span>
                  <span class="row-artist">{song.artist}</span>
                </a>
                {song.key && <span class="row-key">{song.key}</span>}
                <button
                  class="fav"
                  data-fav={`${song.artistSlug}/${song.songSlug}`}
                  aria-label="В избранное"
                  aria-pressed="false"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 4.2l2.4 5 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4-3.9-3.8 5.4-.8z"></path>
                  </svg>
                </button>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="empty" id="catalog-empty" hidden>Ничего не нашлось. Попробуйте другое слово.</p>
  </div>
</MainLayout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .search-row {
    position: sticky;
    top: 0;
    z-index: 5;
    padding: 4px 0 8px;
    background: var(--bg);
  }

  .search-field {
    position: relative;
    display: block;
  }

  .search-field svg {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    stroke: var(--ink-3);
    stroke-width: 1.8;
    fill: none;
    stroke-linecap: round;
    pointer-events: none;
  }

  /* Базовые стили поля поиска — в общей таблице стилей (MainLayout). */
  .search-input {
    min-height: 52px;
    padding: 0 16px 0 44px;
    border-radius: var(--r);
  }

  .switch {
    display: flex;
    gap: 2px;
    padding: 3px;
    background: var(--surface-2);
    border-radius: 999px;
  }

  .switch-btn {
    flex: 1;
    min-height: 42px;
    border: none;
    border-radius: 999px;
    background: none;
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-3);
  }

  .switch-btn.active {
    background: var(--bg);
    color: var(--ink);
  }

  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
  }

  .chips::-webkit-scrollbar {
    display: none;
  }

  .chip {
    flex: none;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-2);
  }

  .chip.active {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .block-label,
  .group-label {
    font-size: 0.86rem;
    font-weight: 650;
    color: var(--ink-3);
    padding: 10px 2px 6px;
  }

  .group + .group {
    margin-top: 10px;
  }

  .rows {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 62px;
    border-bottom: 1px solid var(--line);
  }

  .row-link {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 0;
  }

  .row-title {
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .row-artist {
    font-size: 0.82rem;
    color: var(--ink-3);
  }

  .row-key {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-3);
  }

  .fav {
    flex: none;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--ink-3);
  }

  .fav svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linejoin: round;
  }

  .fav[aria-pressed='true'] {
    color: var(--accent);
  }

  .fav[aria-pressed='true'] svg {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .empty {
    padding: 32px 4px;
    color: var(--ink-3);
    font-size: 0.92rem;
  }

  @media (min-width: 900px) {
    .home {
      gap: 22px;
    }

    .rows {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 28px;
    }

    .row {
      min-height: 58px;
    }
  }
</style>

<script>
  import { getFavorites, getRecent } from '../utils/store.js';

  const input = document.getElementById('catalog-search') as HTMLInputElement | null;
  const empty = document.getElementById('catalog-empty');
  const views = {
    artist: document.getElementById('view-artist'),
    key: document.getElementById('view-key')
  };
  const switchButtons = Array.from(document.querySelectorAll<HTMLElement>('.switch-btn'));
  const chips = Array.from(document.querySelectorAll<HTMLElement>('.chip'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-search-group]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-search-item]'));

  let query = '';
  let keyFilter = '';

  function applyFilter() {
    let visible = 0;
    items.forEach(item => {
      const text = item.getAttribute('data-search-text') || '';
      const key = item.getAttribute('data-key') || '';
      const matchQuery = !query || text.includes(query);
      const matchKey = !keyFilter || key === keyFilter;
      const show = matchQuery && matchKey;
      item.hidden = !show;
      if (show) visible++;
    });

    groups.forEach(group => {
      group.hidden = group.querySelector('[data-search-item]:not([hidden])') === null;
    });

    if (empty) empty.hidden = visible !== 0;
  }

  input?.addEventListener('input', () => {
    query = input.value.trim().toLowerCase();
    applyFilter();
  });

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const key = chip.getAttribute('data-key') || '';
      keyFilter = keyFilter === key ? '' : key;
      chips.forEach(item => item.classList.toggle('active', item === chip && keyFilter !== ''));
      applyFilter();
    });
  });

  switchButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.getAttribute('data-view') || 'artist';
      switchButtons.forEach(item => item.classList.toggle('active', item === btn));
      Object.entries(views).forEach(([name, node]) => {
        if (node) node.hidden = name !== view;
      });
      applyFilter();
    });
  });

  /* ---------------------- Недавние и избранное ---------------------- */
  const rowBySlug = new Map<string, HTMLElement>();
  items.forEach(item => {
    const slug = item.getAttribute('data-slug');
    if (slug && !rowBySlug.has(slug)) rowBySlug.set(slug, item);
  });

  function paintFavButtons(container: HTMLElement) {
    const favorites = getFavorites();
    container.querySelectorAll<HTMLElement>('[data-fav]').forEach(btn => {
      const slug = btn.getAttribute('data-fav') || '';
      const active = favorites.includes(slug);
      btn.setAttribute('aria-pressed', String(active));
      btn.setAttribute('aria-label', active ? 'Убрать из избранного' : 'В избранное');
    });
  }

  function renderBlock(containerId: string, blockId: string, slugs: string[]) {
    const container = document.getElementById(containerId);
    const block = document.getElementById(blockId);
    if (!container || !block) return;

    container.innerHTML = '';
    slugs.forEach(slug => {
      const source = rowBySlug.get(slug);
      if (!source) return;
      const clone = source.cloneNode(true) as HTMLElement;
      clone.removeAttribute('data-search-item');
      clone.hidden = false;
      container.appendChild(clone);
    });

    paintFavButtons(container);
    block.hidden = container.children.length === 0;
  }

  function refreshBlocks() {
    renderBlock('recent-rows', 'recent-block', getRecent());
    renderBlock('fav-rows', 'fav-block', getFavorites());
  }

  window.addEventListener('songbook:favorites', refreshBlocks);
  refreshBlocks();
</script>
