---
import MainLayout from '../layouts/MainLayout.astro';
import { getAllSongs } from '../utils/songParser.js';

const base = import.meta.env.BASE_URL; // '/songs/'

const songs = getAllSongs();
const totalSongs = songs.length;
const totalArtists = new Set(songs.map(s => s.artist)).size;

// Group songs by artist for the catalog
const groupedSongs = songs.reduce((acc, song) => {
  if (!acc[song.artist]) {
    acc[song.artist] = {
      name: song.artist,
      slug: song.artistSlug,
      songs: []
    };
  }
  acc[song.artist].songs.push(song);
  return acc;
}, {} as Record<string, { name: string; slug: string; songs: typeof songs }>);

const sortedArtists = Object.values(groupedSongs).sort((a, b) => a.name.localeCompare(b.name));
sortedArtists.forEach(artist => {
  artist.songs.sort((a, b) => a.title.localeCompare(b.title));
});
---

<MainLayout title="Все песни">
  <div class="catalog">
    <div class="catalog-intro">
      <h1 class="catalog-title">Песенник</h1>
      <p class="catalog-subtitle">
        {totalSongs} песен · {totalArtists} исполнителей · работает без интернета
      </p>
    </div>

    <div class="search-row">
      <input
        type="search"
        id="catalog-search"
        class="search-input"
        placeholder="Поиск: песня или исполнитель"
        data-search-target="#catalog-list"
        autocomplete="off"
        enterkeyhint="search"
      />
    </div>

    <div id="catalog-list" class="catalog-list">
      {sortedArtists.map(artist => (
        <section class="artist-section" data-search-group>
          <h2 class="artist-heading">
            <span>{artist.name}</span>
            <span class="artist-count">{artist.songs.length}</span>
          </h2>
          <ul class="song-rows">
            {artist.songs.map(song => (
              <li>
                <a
                  class="song-row"
                  href={`${base}${song.artistSlug}/${song.songSlug}/`}
                  data-search-item
                  data-search-text={`${song.title} ${artist.name}`.toLowerCase()}
                >
                  <span class="song-row-title">{song.title}</span>
                  <span class="song-row-meta">
                    {song.key && <span class="chip">{song.key}</span>}
                    <span class="chevron" aria-hidden="true">›</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <div class="empty-state" data-search-empty hidden>Песни не найдены</div>
    </div>
  </div>
</MainLayout>

<style>
  .catalog {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .catalog-intro {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .catalog-title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .catalog-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Search stays reachable while scrolling the long list */
  .search-row {
    position: sticky;
    top: -18px;
    z-index: 5;
    padding: 10px 0;
    background: var(--bg-main);
  }

  .catalog-list {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .artist-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .artist-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    padding: 0 2px;
  }

  .artist-count {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
  }

  .song-rows {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .song-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: var(--tap);
    padding: 11px 14px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    transition: var(--transition-smooth);
  }

  .song-row:active {
    border-color: var(--accent);
    background: var(--accent-glow);
  }

  .song-row-title {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .song-row-meta {
    flex: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .chip {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--chord-bg);
    color: var(--chord-color);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .chevron {
    color: var(--text-muted);
    font-size: 1.2rem;
    line-height: 1;
  }

  @media (min-width: 900px) {
    .catalog-title {
      font-size: 2rem;
    }

    .catalog-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 24px;
      align-items: start;
    }
  }
</style>
