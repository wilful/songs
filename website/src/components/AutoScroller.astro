---
---

<div class="autoscroller-widget">
  <span class="widget-label">Автоскролл</span>
  <div class="controls-group">
    <button class="btn-ctrl" id="scroll-toggle" aria-label="Начать автопрокрутку">
      <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5.5l10 6.5-10 6.5z" />
      </svg>
      <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 5v14M15 5v14" />
      </svg>
    </button>
    <button class="btn-speed" id="scroll-speed-down" aria-label="Медленнее">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 12h12" />
      </svg>
    </button>
    <span class="speed-value" id="scroll-speed-val">1x</span>
    <button class="btn-speed" id="scroll-speed-up" aria-label="Быстрее">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 6v12M6 12h12" />
      </svg>
    </button>
  </div>
</div>

<style>
  .autoscroller-widget {
    display: inline-flex;
    align-items: center;
    flex: none;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 5px 6px 5px 12px;
    border-radius: var(--radius-pill);
    gap: 8px;
    box-shadow: var(--shadow-sm), 0 1px 0 var(--border-highlight) inset;
    user-select: none;
  }

  .widget-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .controls-group {
    display: flex;
    align-items: center;
    gap: 2px;
    background: var(--bg-main);
    border: 1px solid var(--border-color);
    padding: 2px;
    border-radius: 999px;
  }

  .btn-ctrl,
  .btn-speed {
    touch-action: manipulation;
    -webkit-appearance: none;
    appearance: none;
    background: none;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-smooth);
  }

  .btn-ctrl {
    width: 38px;
    height: 38px;
    color: var(--text-primary);
    background: var(--bg-card);
  }

  .btn-speed {
    width: 38px;
    height: 38px;
    color: var(--text-muted);
  }

  .btn-ctrl svg,
  .btn-speed svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
  }

  .btn-ctrl .icon-play {
    margin-left: 1px;
    fill: var(--text-primary);
    stroke: none;
  }

  .btn-ctrl .icon-pause {
    display: none;
  }

  /* While the sheet is scrolling the button turns into a pause control. */
  .btn-ctrl.active {
    color: var(--accent);
    background: var(--accent-glow);
  }

  .btn-ctrl.active .icon-play {
    display: none;
  }

  .btn-ctrl.active .icon-pause {
    display: block;
  }

  .btn-speed:hover {
    background: var(--bg-card);
    color: var(--text-primary);
  }

  .btn-ctrl:active,
  .btn-speed:active {
    transform: scale(0.94);
  }

  .speed-value {
    min-width: 36px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  @media (min-width: 900px) {
    .autoscroller-widget {
      padding: 5px 8px 5px 16px;
      gap: 12px;
    }

    .btn-ctrl,
    .btn-speed {
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  let isScrolling = false;
  let scrollSpeedIndex = 2; // Default 1x (index 2 in speeds list)
  
  // Speed multiplier list (pixels per frame at 60fps)
  const speeds = [0.15, 0.3, 0.6, 1.2, 2.0, 3.5];
  const speedLabels = ["0.25x", "0.5x", "1x", "2x", "3x", "5x"];

  const toggleBtn = document.getElementById('scroll-toggle');
  const speedDownBtn = document.getElementById('scroll-speed-down');
  const speedUpBtn = document.getElementById('scroll-speed-up');
  const speedDisplay = document.getElementById('scroll-speed-val');
  const scrollContainer = document.getElementById('scroll-container');

  let animationFrameId: number | null = null;
  let lastScrollTop = 0;

  // Screen Wake Lock: keeps the display on during auto-scroll (best effort,
  // silently ignored where the API is missing).
  let wakeLock: WakeLockSentinel | null = null;

  async function requestWakeLock() {
    try {
      if ('wakeLock' in navigator) {
        wakeLock = await navigator.wakeLock.request('screen');
      }
    } catch (error) {
      wakeLock = null;
    }
  }

  async function releaseWakeLock() {
    try {
      await wakeLock?.release();
    } catch (error) {
      /* already released */
    }
    wakeLock = null;
  }

  // Wake locks are dropped when the page is hidden; take one back on return.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && isScrolling && !wakeLock) {
      void requestWakeLock();
    }
  });

  function autoScrollLoop() {
    if (!isScrolling || !scrollContainer) return;
    
    // Add exact speed increment
    scrollContainer.scrollTop += speeds[scrollSpeedIndex];

    // Stop auto scroll if user reached the absolute bottom
    const isAtBottom = scrollContainer.scrollHeight - scrollContainer.scrollTop <= scrollContainer.clientHeight + 1;
    if (isAtBottom) {
      stopScrolling();
      return;
    }

    animationFrameId = requestAnimationFrame(autoScrollLoop);
  }

  function startScrolling() {
    if (isScrolling) return;
    isScrolling = true;

    // Keep the phone screen awake while the sheet scrolls (best effort).
    void requestWakeLock();

    if (toggleBtn) {
      toggleBtn.classList.add('active');
      toggleBtn.setAttribute('aria-label', 'Остановить автопрокрутку');
    }
    
    autoScrollLoop();
  }

  function stopScrolling() {
    if (!isScrolling) return;
    isScrolling = false;

    void releaseWakeLock();

    if (toggleBtn) {
      toggleBtn.classList.remove('active');
      toggleBtn.setAttribute('aria-label', 'Начать автопрокрутку');
    }
    
    if (animationFrameId !== null) {
      cancelAnimationFrame(animationFrameId);
      animationFrameId = null;
    }
  }

  toggleBtn?.addEventListener('click', () => {
    if (isScrolling) {
      stopScrolling();
    } else {
      startScrolling();
    }
  });

  speedDownBtn?.addEventListener('click', () => {
    if (scrollSpeedIndex > 0) {
      scrollSpeedIndex--;
      if (speedDisplay) {
        speedDisplay.textContent = speedLabels[scrollSpeedIndex];
      }
    }
  });

  speedUpBtn?.addEventListener('click', () => {
    if (scrollSpeedIndex < speeds.length - 1) {
      scrollSpeedIndex++;
      if (speedDisplay) {
        speedDisplay.textContent = speedLabels[scrollSpeedIndex];
      }
    }
  });

  // Stop scrolling on manual scroll interaction
  scrollContainer?.addEventListener('mousedown', stopScrolling);
  scrollContainer?.addEventListener('wheel', stopScrolling);
  scrollContainer?.addEventListener('touchstart', stopScrolling);
</script>
